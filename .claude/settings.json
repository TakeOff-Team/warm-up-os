{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(wiki/*)",
      "Write(wiki/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Edit(archive/*)",
      "Write(archive/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(rm -rf *)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked: destructive rm -rf not allowed in Warm-Up-OS' >&2 && exit 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Session ended. Did anything need to land in INDEX.md or wiki/?' >&2"
          }
        ]
      }
    ]
  }
}
